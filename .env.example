# Copy to .env for local/ROG use. Never commit the filled .env.
COURSE_ACCOUNT=
COURSE_PASSWORD=
# Leave -1 for a linked phone account. Use institution ID for institution login.
COURSE_FID=-1
COURSE_ENTRY_URL=
COURSE_QUERY=
# Optional single-replay override. When set, COURSE_ENTRY_URL/QUERY are ignored.
COURSE_REPLAY_URL=

# none / email / qq / both
DELIVERY=none
MAX_LECTURES=1
COURSE_HEADLESS=true

# QQ Mail example. SMTP_PASSWORD is an SMTP authorization code, not web password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=
RECEIVER_EMAIL=
MAIL_FROM=
MAIL_MAX_RAW_MB=18
# Optional independent encryption key. Keep it stable when changing login password.
STATE_KEY=

# ROG optional OneBot/NapCat private file delivery.
QQ_API_URL=
QQ_API_TOKEN=
QQ_TARGET_USER_ID=
# Optional path to output directory as seen by the QQ service.
QQ_FILE_ROOT=
